# Snakefile for SComatic Analysis Pipeline

###### Running on HPC ######
## Make sure the slurm executor plug-in is installed:
## conda activate snakemake # assume snakemake is the name of the conda env for your pipeline
## pip install snakemake-executor-plugin-slurm
##
## make sure conda env yaml files are in both the working directory and the snakemake.dir, or wherever the snakefile is located
## conda envs can be pre-installed using:
## snakemake --sdm conda --conda-create-envs-only -s snakemake.dir/snakefile --configfile snakemake.dir/config.yaml
##
## #### dry run ####
## snakemake -s snakemake.dir/snakefile --configfile snakemake.dir/config.yaml -n --rerun-triggers mtime
##
## #### execute pipeline ####
## nohup nice -19 snakemake -s snakemake.dir/snakefile --configfile snakemake.dir/config.yaml --sdm conda --profile snakeprofile --latency-wait 650 --slurm-init-seconds-before-status-checks 500 -j 25  --rerun-triggers mtime  --rerun-incomplete&
##
##
## monitor pipeline progress with:
## tail -f -n20 nohup.out
##
##
##
####

configfile: "config.yaml"

import pandas as pd
import os
from pathlib import Path
import glob

# Chromosomes to analyse: config "chroms" (list or comma-separated string),
# default chr1-22 + chrM
_chroms = config.get("chroms") or [f"chr{i}" for i in range(1, 23)] + ["chrM"]
CHROMS = _chroms.split(",") if isinstance(_chroms, str) else list(_chroms)
CELL_TYPES = config["celltypes"].split(",")

# Pipeline scripts directory: config "src_dir", default <repo>/scripts
SRC_DIR = config.get("src_dir") or os.path.join(workflow.basedir, "..", "scripts")

# Single-pass counting options (see scripts/CellTypeBaseCounter.py)
MIN_BQ = config.get("min_bq", 30)
MIN_TOTAL_ALT = config.get("min_total_alt", 1)
COUNTER_THREADS = config.get("counter_threads", 8)

def get_samples_from_bams():
    bam_files = glob.glob(os.path.join(config["bam_dir"], "*.bam"))
    # Strip off both .bam and any cell type suffixes
    samples = [os.path.basename(bam).replace(".bam", "") for bam in bam_files]
    samples = list(set(samples))  # Remove duplicates
    if not samples:
        raise ValueError(f"No .bam files found in {config['bam_dir']}")
    return(samples)

# Get sample list
SAMPLES = get_samples_from_bams()
#SAMPLES = ["ParseExp1617"] # there is only one Parse BAM file

rule all:
    input:
        expand("results/germline/{sample}_{celltype}_not_germline.tsv",
               sample=SAMPLES,
	       celltype=CELL_TYPES,
               chrom=CHROMS),
        expand("results/genotyped/{sample}_{celltype}_{chrom}.single_cell_genotype.tsv",
               sample=SAMPLES,
               celltype=CELL_TYPES,
               chrom=CHROMS),
         "envs/biocfilter_setup_complete"

# Everything up to per-cell genotypes (no germline filtering / R environment)
rule all_genotyped:
    input:
        expand("results/genotyped/{sample}_{celltype}_{chrom}.single_cell_genotype.tsv",
               sample=SAMPLES,
               celltype=CELL_TYPES,
               chrom=CHROMS)


# ---------------------------------------------------------------------------
# Optional: cell-type-specific BAMs (e.g. for viewing in IGV).
# NOT used by the default pipeline any more: counting and genotyping now read
# the original BAM directly (rules celltype_base_counts / genotype_cells).
# Build them with:  snakemake ... all_split_bams
# ---------------------------------------------------------------------------
rule split_by_celltype:
    input:
        bam = os.path.join(config["bam_dir"], "{sample}.bam")
    output:
        split_bams = expand("results/split_bams/{{sample}}/{{sample}}_{celltype}_{{chrom}}.bam",
                          celltype=CELL_TYPES)
    params:
        outdir = "results/split_bams/{sample}",
        script = os.path.join(SRC_DIR, "split_by_celltype-parallel.py"),
        meta = config["cell_type_file"],
        sra_meta = config["sra_metadata"],
        celltypes = config["celltypes"],
        window = config["window"],
        batch_col = config["batch_column"],
        batch_pos = config["batch_position"]
    resources:
        mem_mb = 12000,
        runtime = "12d",
        partition = "uoa-compute",
        cpus_per_task = 8,
        cpus = 8
    conda:
        "envs/scomatic.yaml"
    threads: 8
    log:
        "logs/split_bams/{sample}_{chrom}.log"
    shell:
        """
        mkdir -p {params.outdir}

        python {params.script} \
            --bamfile {input.bam} \
            --outdir {params.outdir} \
            --chrom {wildcards.chrom} \
            --sra_meta {params.sra_meta} \
            --batch_pos {params.batch_pos} \
            --batch_column {params.batch_col} \
            --threads {threads} \
            --celltypes {params.celltypes} \
            --metafile {params.meta} \
            --chunk_size {params.window} \
            --log {log};
        """

rule all_split_bams:
    input:
        expand("results/split_bams/{sample}/{sample}_{celltype}_{chrom}.bam",
               sample=SAMPLES,
               celltype=CELL_TYPES,
               chrom=CHROMS)

# Index split BAM files
rule index_split_bams:
    input:
        bam = "results/split_bams/{sample}/{sample}_{celltype}_{chrom}.bam"
    output:
        bai = "results/split_bams/{sample}/{sample}_{celltype}_{chrom}.bam.bai"
    resources:
        mem_mb = 4000,
        runtime = 180,
        partition = "uoa-compute",
        cpus = 1
    conda:
        "envs/scomatic.yaml"
    log:
        "logs/index_bam/{sample}_{celltype}_{chrom}.log"
    shell:
        """
        samtools index {input.bam} {output.bai} 2> {log}
        """

# ---------------------------------------------------------------------------
# Single-pass, cell-type-aware base counting on the ORIGINAL BAM.
# Replaces split_by_celltype -> index_split_bams -> base_counter (x cell types)
# -> merge_base_counts. Output has the same name and format as
# MergeBaseCellCounts.py, so variant_calls is unchanged.
# ---------------------------------------------------------------------------

# Index the original BAM (skipped if {sample}.bam.bai already exists and is newer)
rule index_bam:
    input:
        bam = os.path.join(config["bam_dir"], "{sample}.bam")
    output:
        bai = os.path.join(config["bam_dir"], "{sample}.bam.bai")
    threads: 4
    resources:
        mem_mb = 4000,
        runtime = 180,
        partition = "uoa-compute",
        cpus = 4
    conda:
        "envs/scomatic.yaml"
    log:
        "logs/index_bam/{sample}.log"
    shell:
        """
        samtools index -@ {threads} {input.bam} 2> {log}
        """

rule celltype_base_counts:
    input:
        bam = os.path.join(config["bam_dir"], "{sample}.bam"),
        bai = os.path.join(config["bam_dir"], "{sample}.bam.bai")
    output:
        merged = "results/merged_counts/{sample}_{chrom}_AllCellTypes.tsv"
    params:
        script = os.path.join(SRC_DIR, "CellTypeBaseCounter.py"),
        fasta = lambda wildcards: f"{config['ref_dir']}/{wildcards.chrom}.fa.gz",
        meta = config["cell_type_file"],
        sra_meta = config["sra_metadata"],
        celltypes = config["celltypes"],
        batch_col = config["batch_column"],
        batch_pos = config["batch_position"],
        min_bq = MIN_BQ,
        min_total_alt = MIN_TOTAL_ALT
    threads: COUNTER_THREADS
    resources:
        mem_mb = 8000,
        runtime = 1440,
        partition = "uoa-compute",
        cpus_per_task = COUNTER_THREADS,
        cpus = COUNTER_THREADS
    conda:
        "envs/scomatic.yaml"
    log:
        "logs/celltype_base_counts/{sample}_{chrom}.log"
    shell:
        """
        python {params.script} \
            --bam {input.bam} \
            --ref {params.fasta} \
            --chrom {wildcards.chrom} \
            --meta {params.meta} \
            --sra_meta {params.sra_meta} \
            --batch_column {params.batch_col} \
            --batch_pos {params.batch_pos} \
            --celltypes {params.celltypes} \
            --min_bq {params.min_bq} \
            --min_total_alt {params.min_total_alt} \
            --nprocs {threads} \
            --outfile {output.merged} \
            2> {log}
        """

# Variant calling
rule variant_calls:
    input:
        counts = "results/merged_counts/{sample}_{chrom}_AllCellTypes.tsv"
    output:
        calls = "results/variant_calls/{sample}_{chrom}.calling.step1.tsv"
    params:
        ref = lambda wildcards: f"{config['ref_dir']}/{wildcards.chrom}.fa.gz",
        outfile = "results/variant_calls/{sample}_{chrom}"
    resources:
        mem_mb = 12000,
        runtime = 2820,
        partition = "uoa-compute",
        cpus = 1
    conda:
        "envs/scomatic.yaml"
    log:
        "logs/variant_calls/{sample}_{chrom}.log"
    shell:
        """
        touch {output.calls}
        
        python {config[scomatic_dir]}/scripts/BaseCellCalling/BaseCellCalling.step1.py \
            --infile {input.counts} \
            --outfile {params.outfile} \
            --ref {params.ref} \
            --min_cells 5 \
            --min_ac_cells 2 \
            --min_ac_reads 3 \
            --max_cell_types 6 \
            --min_cell_types 1 \
            --fisher_cutoff 0.001 \
            2> {log}
        """

# Filter variant calls
rule filter_calls:
    input:
        vcf = "results/variant_calls/{sample}_{chrom}.calling.step1.tsv"
    output:
        filtered = "results/filtered_calls/{sample}_{chrom}.calling.step2.tsv"
    params:
        pon = config["panel_of_normals"],
        editing = config["rna_editing_sites"],
        filt_out = "results/filtered_calls/{sample}_{chrom}"
    resources:
        mem_mb = 8000,
        runtime = 2040,
        partition = "spot-compute",
        cpus = 1
    conda:
        "envs/scomatic.yaml"
    log:
        "logs/filter_calls/{sample}_{chrom}.log"
    shell:
        """
        python {config[scomatic_dir]}/scripts/BaseCellCalling/BaseCellCalling.step2.py \
            --infile {input.vcf} \
            --outfile {params.filt_out} \
            --pon {params.pon} \
            --editing {params.editing} \
            2> {log}
        """

## QC filtering of variants
## If contigs have chr or Chr then use from shell command:
## -b <(cat {config[scomatic_dir]}/bed_files_of_interest/UCSC.k100_umap.without.repeatmasker.bed ) |
## Otherwise, if no chr or Chr:
## -b <(cat {config[scomatic_dir]}/bed_files_of_interest/UCSC.k100_umap.without.repeatmasker.bed | sed 's/chr//g' ) |

rule qc_filter:
    input:
        calls = "results/filtered_calls/{sample}_{chrom}.calling.step2.tsv"
    output:
        filtered = "results/qc_filtered/{sample}_{chrom}.filtered.vcf"
    conda:
        "envs/bedtools.yaml"
    log:
        "logs/qc_filter/{sample}_{chrom}.log"
    resources:
        mem_mb = 8000,
        runtime = 2040,
        partition = "spot-compute",
        cpus = 1
    shell:
        """
        bedtools intersect -header \
            -a {input.calls} \
            -b <(cat {config[scomatic_dir]}/bed_files_of_interest/UCSC.k100_umap.without.repeatmasker.bed ) |\
            awk -F "\t" '$1 ~ /^#/ || $6 == ""' > {output.filtered} 2> {log}
        """

# Barcode -> cell type table matching the CB tags of the ORIGINAL BAM
# (batch prefix/suffix removed), for SingleCellGenotype.py
rule sample_meta:
    input:
        bam = os.path.join(config["bam_dir"], "{sample}.bam")
    output:
        meta = "results/sample_meta/{sample}.meta.tsv"
    params:
        script = os.path.join(SRC_DIR, "make_sample_meta.py"),
        meta = config["cell_type_file"],
        sra_meta = config["sra_metadata"],
        celltypes = config["celltypes"],
        batch_col = config["batch_column"],
        batch_pos = config["batch_position"]
    resources:
        mem_mb = 4000,
        runtime = 30,
        partition = "uoa-compute",
        cpus = 1
    conda:
        "envs/scomatic.yaml"
    log:
        "logs/sample_meta/{sample}.log"
    shell:
        """
        python {params.script} \
            --meta {params.meta} \
            --bam {input.bam} \
            --sra_meta {params.sra_meta} \
            --batch_column {params.batch_col} \
            --batch_pos {params.batch_pos} \
            --celltypes {params.celltypes} \
            --out {output.meta} \
            2> {log}
        """

# Genotype all cells once per sample x chromosome on the original BAM, then
# split by observed cell type (column 9) so filter_germline gets the same
# per-cell-type files as before.
# --max_dp: SingleCellGenotype caps pileup depth at 8000 by default (and pysam
# treats 0 as that same cap). On the combined BAM the cap would be reached at
# highly expressed genes, so pass a large number.
rule genotype_cells:
    input:
        vcf = "results/qc_filtered/{sample}_{chrom}.filtered.vcf",
        bam = os.path.join(config["bam_dir"], "{sample}.bam"),
        bai = os.path.join(config["bam_dir"], "{sample}.bam.bai"),
        meta = "results/sample_meta/{sample}.meta.tsv"
    output:
        all_cells = "results/genotyped_all/{sample}_{chrom}.single_cell_genotype.tsv",
        genotypes = expand("results/genotyped/{{sample}}_{celltype}_{{chrom}}.single_cell_genotype.tsv",
                           celltype=CELL_TYPES)
    params:
        temp_dir = "results/temp/genotype_{sample}_{chrom}",
        ref = lambda wildcards: f"{config['ref_dir']}/{wildcards.chrom}.fa.gz",
        celltypes = " ".join(CELL_TYPES),
        outdir = "results/genotyped"
    threads: 4
    resources:
        mem_mb = 8000,
        runtime = 600,
        partition = "spot-compute",
        cpus_per_task = 4,
        cpus = 4
    conda:
        "envs/scomatic.yaml"
    log:
        "logs/genotype_cells/{sample}_{chrom}.log"
    shell:
        """
        mkdir -p {params.temp_dir}
        python {config[scomatic_dir]}/scripts/SingleCellGenotype/SingleCellGenotype.py \
            --bam {input.bam} \
            --infile {input.vcf} \
            --nprocs {threads} \
            --max_dp 1000000000 \
            --meta {input.meta} \
            --outfile {output.all_cells} \
            --tmp_dir {params.temp_dir} \
            --ref {params.ref} \
            2> {log}
        rm -rf {params.temp_dir}

        for ct in {params.celltypes}; do
            awk -F '\t' -v ct="$ct" '$1 ~ /^#/ || $9 == ct' {output.all_cells} \
                > {params.outdir}/{wildcards.sample}_${{ct}}_{wildcards.chrom}.single_cell_genotype.tsv
        done
        """

rule setup_biocfilter_env:
    """Setup rule to install Bioconductor packages"""
    output:
        flag = "envs/biocfilter_setup_complete"
    resources:
        mem_mb = 6000,
        runtime = "1d",
        partition = "uoa-compute",
        cpus = 1
    conda:
        "envs/biocfilter.yaml"
    log:
        "logs/installs/biocfilter_setup.log"
    shell:
        """
        Rscript scripts/install_bioc_packages.R  2> {log}
        touch {output.flag}
        """

rule filter_germline:
    input:
        snps = expand("results/genotyped/{{sample}}_{{celltype}}_{chrom}.single_cell_genotype.tsv",
		      chrom=CHROMS),
        bioc = "envs/biocfilter_setup_complete"
    output:
        germline = "results/germline/{sample}_{celltype}_not_germline.tsv"
    params:
        rscript = os.path.join(config["src_dir"], config["germline_filter"]),
        indir = "results/genotyped/",
        pattern = lambda wildcards: f"{wildcards.sample}_{wildcards.celltype}"
    resources:
        mem_mb = 32000,
        runtime = "1d",
        partition = "uoa-compute",
        cpus = 1
    conda:
        "envs/biocfilter.yaml"
    log:
        "logs/germline/{sample}_{celltype}_not_germline.log"
    shell:
        """
        touch {output.germline}

        Rscript {params.rscript} --in_path {params.indir} \
            --sample {wildcards.sample} \
            --celltype {wildcards.celltype} \
            --output {output.germline} \
            2> {log}
        """

        
